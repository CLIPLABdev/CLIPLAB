APP_NAME=ClipLab
APP_ENV=production
APP_DEBUG=false
APP_URL=https://example.com
APP_TIMEZONE=UTC
# Chave mestra base64 de 32 bytes para overrides Gemini salvos no painel admin.
# Gere somente no servidor; nunca coloque o valor real no repositório.
APP_ENCRYPTION_KEY=
# Em produção, normalmente não defina APP_ENV_FILE: o bootstrap carrega .env.
# APP_ENV_FILE vazio desabilita arquivo; um path não vazio seleciona somente esse arquivo.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cliplab
DB_USERNAME=cliplab
DB_PASSWORD=

MAIL_TRANSPORT=smtp
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=ClipLab
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_ENCRYPTION=tls
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_SMTP_TIMEOUT=10
# Set MAIL_TRANSPORT=log only in local development. Its default log is the sensitive,
# non-public <project>/storage/logs/password-reset.log file; never commit or share it.
# Set MAIL_LOG_FILE only to an absolute, protected local path when overriding the default.

# Store media outside public_html whenever the hosting plan permits it. Never use public/.
MEDIA_DISK=local
# MEDIA_PRIVATE_ROOT=
MEDIA_MAX_UPLOAD_BYTES=524288000
MEDIA_DOWNLOAD_TIMEOUT_SECONDS=120
MEDIA_MAX_REDIRECTS=2

# YouTube imports are disabled by default. Enable only after installing an operator-pinned
# official yt-dlp binary and a supported local JavaScript runtime. Do not configure cookies,
# credentials, browser impersonation, or remote components.
YOUTUBE_IMPORT_ENABLED=false
YTDLP_BINARY=yt-dlp
# Example: node:/absolute/path/to/node (use an absolute server path in production).
YTDLP_JS_RUNTIME=
YTDLP_TIMEOUT_SECONDS=60
YTDLP_OUTPUT_LIMIT_BYTES=1048576

# Use only an operator-controlled executable name or absolute path; never user input.
FFPROBE_BINARY=ffprobe
FFMPEG_BINARY=ffmpeg
PROCESS_TIMEOUT_SECONDS=60
PROCESS_OUTPUT_LIMIT_BYTES=1048576
RENDER_TIMEOUT_SECONDS=240
RENDER_MAX_OUTPUT_BYTES=524288000
RENDER_MAX_DURATION_SECONDS=180
RENDER_THUMBNAIL_MAX_BYTES=10485760
REFRAME_MAX_DURATION_SECONDS=90
REFRAME_MAX_KEYFRAMES=32
REFRAME_PREVIEW_MAX_FRAMES=180
REFRAME_PREVIEW_MAX_EDGE=320
MEDIAPIPE_ASSET_VERSION=1.0.1

# Worker lease mínimo = max(GEMINI_HTTP_TIMEOUT_SECONDS + PROCESS_TIMEOUT_SECONDS, RENDER_TIMEOUT_SECONDS,
# MEDIA_DOWNLOAD_TIMEOUT_SECONDS + PROCESS_TIMEOUT_SECONDS) + 30.
QUEUE_LEASE_SECONDS=300
QUEUE_MAX_ATTEMPTS=3
QUEUE_BATCH_SIZE=1

# Gemini is called only by the CLI worker. Keep credentials server-side and leave them
# empty in source control; choose an available model explicitly in the deployment env.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_HTTP_TIMEOUT_SECONDS=180
GEMINI_RESPONSE_LIMIT_BYTES=1048576
GEMINI_FILE_POLL_SECONDS=15
# Validation attempts are fixed at two for this release.
GEMINI_VALIDATION_ATTEMPTS=2
GEMINI_ANALYSIS_MAX_ATTEMPTS=6
GEMINI_CREDITS_PER_MINUTE=1
